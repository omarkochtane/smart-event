            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200\", function () { pm.response.to.have.status(200); });",
                  "var d = pm.response.json();",
                  "pm.collectionVariables.set(\"tokenStudent\", d.token);",
